import java.util.Scanner;

public class bai1 {
    public static String snt (int n){
        if(n<2) return "NO" ;
        for(int i = 2 ; i <= Math.sqrt(n) ; i++){
            if(n%i==0) {
                return "NO" ;
            }
        }
        return "YES" ;
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in) ;
        int n = sc.nextInt();
        while(n>0){
            n--;
            int t = sc.nextInt();
            System.out.println(snt(t));
        }
    }
}
