import java.util.Scanner;

public class bai1 {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in) ;
        int n = sc.nextInt();
        long sum = 1 ;
        long res = 0 ;
        for(int i = 1 ; i <= n ; i++){
            sum *= i ;
            res += sum ;
        }
        System.out.print(res);
    }
}
