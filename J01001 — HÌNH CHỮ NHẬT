import java.util.Scanner;
public class bai1{
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n  = sc.nextInt();
        int m = sc.nextInt();
        if(n > 0 && m > 0){
            System.out.println(2*(n+m)+" " + (n*m));
        }
        else {
            System.out.println("0");
        }
    }
}
