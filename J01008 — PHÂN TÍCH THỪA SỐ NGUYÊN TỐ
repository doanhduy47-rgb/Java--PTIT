import java.util.Scanner;

public class bai1 {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in) ;
        int t = sc.nextInt();
        for(int k = 1 ; k <= t ; k++){
            int n = sc.nextInt() ;
            System.out.printf("Test %d: ",k);
            int can  =(int)Math.sqrt((double)n) ;
            for(int i = 2 ; i <= can ; i++){
                int cnt = 0 ;
                while(n%i==0){
                    n/=i;
                    cnt++;
                }
                if(cnt>0){
                    System.out.printf("%d(%d) ",i,cnt);
                }
            }
            if(n>1) System.out.printf("%d(1)\n",n);
            System.out.println("");
        }
    }
}
