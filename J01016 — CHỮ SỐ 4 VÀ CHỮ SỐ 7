import java.util.Scanner;

public class bai1 {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in) ;
        String s = sc.next();
        int sum = 0 ;
        for(int i = 0 ; i < s.length() ; i++){
            if (s.charAt(i) == '4' || s.charAt(i)=='7') sum++ ;
        }
        System.out.println((sum == 4 || sum ==7)?"YES" : "NO");
    }
}
