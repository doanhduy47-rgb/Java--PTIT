import java.util.*;
import java.math.BigInteger;

public class bai1 {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int T = Integer.parseInt(sc.nextLine().trim());

        int MAXN = 100;
        BigInteger[] L = new BigInteger[MAXN + 1];
        L[1] = BigInteger.ONE;
        for (int i = 2; i <= MAXN; i++) {
            BigInteger g = L[i-1].gcd(BigInteger.valueOf(i));
            L[i] = L[i-1].multiply(BigInteger.valueOf(i)).divide(g);
        }

        StringBuilder sb = new StringBuilder();
        for (int t = 0; t < T; t++) {
            int n = Integer.parseInt(sc.nextLine().trim());
            sb.append(L[n].toString()).append("\n");
        }
        System.out.print(sb);
    }
}
