import java.util.Scanner;

public class bai1 {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();

        while (n > 0) {
            n--;

            String s = sc.next();

            int sum = 0;
            boolean check = true;

            for (int i = 0; i < s.length(); i++) {
                sum += s.charAt(i) - '0';
                if (i < s.length() - 1) {
                    if (Math.abs(s.charAt(i) - s.charAt(i + 1)) != 2) {
                        check = false;
                    }
                }
            }

            if (check && sum % 10 == 0) {
                System.out.println("YES");
            } else {
                System.out.println("NO");
            }
        }
    }
}
