import java.util.*;

public class bai1 {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();

        long[][] guest = new long[n][2];
        for (int i = 0; i < n; i++) {
            guest[i][0] = sc.nextLong();
            guest[i][1] = sc.nextLong();
        }

        Arrays.sort(guest, new Comparator<long[]>() {
            public int compare(long[] a, long[] b) {
                return Long.compare(a[0], b[0]);
            }
        });

        long finish = 0;
        for (int i = 0; i < n; i++) {
            long T = guest[i][0];
            long D = guest[i][1];
            finish = Math.max(T, finish) + D;
        }

        System.out.println(finish);
    }
}
