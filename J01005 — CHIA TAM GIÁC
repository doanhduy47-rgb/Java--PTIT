import java.util.Scanner;

public class bai1 {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in) ;
        int p = sc.nextInt() ;
        for (int i = 1 ; i <= p ; i++){
            double n = sc.nextDouble();
            double h = sc.nextDouble();
            for(int j = 1 ; j < n ; j++){
                double sm = j/n ;
                double cc = h*(Math.sqrt(sm)) ;
                System.out.printf("%.6f ",cc);
            }
            System.out.println("");
        }
    }
}
