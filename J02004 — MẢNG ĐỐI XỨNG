import java.util.Scanner;

public class bai1 {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in) ;
        int p = sc.nextInt();
        for(int k = 1 ; k <= p ; k++){
            int n = sc.nextInt();
            int[] a = new int[n] ;
            for(int i = 0 ; i < a.length ; i++){
                a[i] = sc.nextInt() ;
            }
            boolean check = true ;
            for(int i = 0 ; i < (a.length / 2) ; i++){
                if(a[i] != a[n-i-1]){
                    check = false ;
                }
            }
            if(check == true){
                System.out.println("YES");
            }
            else System.out.println("NO");
        }
    }
}
